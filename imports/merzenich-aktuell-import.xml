>Die Aktion findet in allen Ortschaften statt. Nach Angaben der Veranstalter werden Müllzangen, Handschuhe und Müllsäcke bereitgestellt. Die Gemeinde verbindet die Aktion mit weiteren Angeboten zur Umweltbildung für Kinder und Jugendliche.</p>]]></content:encoded><excerpt:encoded><![CDATA[Die Faire Woche läuft bis zum 25. September. Am 20. September lädt die Gemeinde von 11 bis 13 Uhr zur Müllsammelaktion in allen Ortschaften ein.]]></excerpt:encoded><wp:post_date>2026-09-14 12:05:00</wp:post_date><wp:post_date_gmt>2026-09-14 12:05:00</wp:post_date_gmt><wp:post_name><![CDATA[faire-woche-merzenich-raeumt-auf-2026]]></wp:post_name><wp:status>draft</wp:status><wp:post_type>post</wp:post_type><wp:comment_status>open</wp:comment_status><wp:ping_status>closed</wp:ping_status><wp:is_sticky>0</wp:is_sticky><category domain="category" nicename="rathaus"><![CDATA[Rathaus & Politik]]></category><category domain="ma_location" nicename="merzenich"><![CDATA[Merzenich]]></category><wp:postmeta><wp:meta_key><![CDATA[ma_source_url]]></wp:meta_key><wp:meta_value><![CDATA[https://www.faire-woche.de/kalender/kalender/veranstaltung?tx_rmfairkalender_eventdetail%5Bevent%5D=1295]]></wp:meta_value></wp:postmeta><wp:postmeta><wp:meta_key><![CDATA[ma_source_publisher]]></wp:meta_key><wp:meta_value><![CDATA[Faire Woche / Gemeinde Merzenich]]></wp:meta_value></wp:postmeta><wp:postmeta><wp:meta_key><![CDATA[ma_source_published_at]]></wp:meta_key><wp:meta_value><![CDATA[2026-08-25T09:43]]></wp:meta_value></wp:postmeta><wp:postmeta><wp:meta_key><![CDATA[ma_source_checked_at]]></wp:meta_key><wp:meta_value><![CDATA[2026-09-14T12:05]]></wp:meta_value></wp:postmeta><wp:postmeta><wp:meta_key><![CDATA[ma_source_verified]]></wp:meta_key><wp:meta_value><![CDATA[1]]></wp:meta_value></wp:postmeta><wp:postmeta><wp:meta_key><![CDATA[ma_date_verified]]></wp:meta_key><wp:meta_value><![CDATA[1]]></wp:meta_value></wp:postmeta><wp:postmeta><wp:meta_key><![CDATA[ma_place_verified]]></wp:meta_key><wp:meta_value><![